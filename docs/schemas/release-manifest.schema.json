{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CIPFZ/rdev/release-manifest/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-(beta|dev)\\.[0-9]+)?$"
    },
    "channel": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "dev"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "tree_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dirty": {
          "type": "boolean"
        }
      },
      "required": [
        "commit",
        "tree_sha256",
        "dirty"
      ]
    },
    "signer": {
      "type": "string",
      "maxLength": 128
    },
    "signature_namespace": {
      "const": "rdev-release"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "binaries": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[^/\\\\]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 536870912
          },
          "goos": {
            "enum": [
              "linux",
              "darwin"
            ]
          },
          "goarch": {
            "enum": [
              "amd64",
              "arm64"
            ]
          }
        },
        "required": [
          "name",
          "sha256",
          "size",
          "goos",
          "goarch"
        ]
      }
    },
    "metadata": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[^/\\\\]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 536870912
          }
        },
        "required": [
          "name",
          "sha256",
          "size"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "version",
    "channel",
    "source",
    "signer",
    "signature_namespace",
    "issued_at",
    "expires_at",
    "binaries",
    "metadata"
  ]
}
